# Copy to .env and fill in. .env is git-ignored; never commit your key.
PROVIDER=openai
OPENAI_API_KEY=sk-...
# Leave empty for api.openai.com. Point at Jan's local API server or llama-server to go fully local.
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
CONTEXT_WINDOW=128000

# --- DTM Studienassistent (knowledge-base mode) ---
# APP_MODE=kb answers only from the PDFs in KB_DIR (ingest with scripts/ingest_kb.py).
APP_MODE=chat
KB_NAME=dtm
KB_DIR=
REFUSAL_CONTACT=Study and Career Service (studienberatung@oth-aw.de, +49 961 382-1133) · Prof. Dr. Julia Heigl, DTM (j.heigl@oth-aw.de)
CHAT_TEMPERATURE=0.1
ADMIN_TOKEN=
# Questions per minute per visitor (browser cookie) and per IP; 0 = off. See README "Hosting".
RATE_LIMIT_PER_MIN=0
RATE_LIMIT_IP_PER_MIN=0
KB_CHUNK_SIZE=1000
KB_OVERLAP=150
KB_TOP_K=8
KB_CHAT_MODEL=gpt-4.1
# Rewrites the question into search queries only; a small model is enough and much faster.
KB_PLAN_MODEL=gpt-4.1-mini
KB_THRESHOLD=0.2
